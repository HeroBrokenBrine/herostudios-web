---
// Official Hero Studios brand mark — uses the official icon asset verbatim.
const { size = 34 } = Astro.props;
---

<a href="/" class="nav__brand" aria-label="Hero Studios home">
  <img src="/brand/icon.jpg" alt="" width={size} height={size} loading="eager" />
  <span>Hero&nbsp;Studios</span>
</a>

<style>
  .nav__brand img {
    border-radius: 9px;
    object-fit: cover;
  }
</style>
