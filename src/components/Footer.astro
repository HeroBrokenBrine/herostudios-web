---
import Logo from "./Logo.astro";
import { site } from "../data/site.js";

const productLinks = [
  { href: "/products", label: "All products" },
  { href: "/downloads", label: "Downloads" },
  { href: "/docs", label: "Documentation" },
  { href: "/roadmap", label: "Roadmap" },
];
const platformLinks = [
  { href: "/developers", label: "Developer portal" },
  { href: "/releases", label: "Release notes" },
  { href: "/tutorials", label: "Tutorials" },
  { href: "/status", label: "System status" },
  { href: "/brand", label: "Brand & press" },
  { href: "/feed.xml", label: "RSS feed" },
];
const companyLinks = [
  { href: "/about", label: "About Hero Studios" },
  { href: "/about#license", label: "License (HBBML)" },
  { href: "/privacy", label: "Privacy" },
  { href: "/terms", label: "Terms" },
  { href: site.issuesUrl, label: "Support portal" },
  { href: site.donateUrl, label: "Support the studio", external: true },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        <div class="footer__brand">
          <img src="/brand/icon.jpg" alt="" width="40" height="40" />
          <span>Hero Studios</span>
        </div>
        <p class="footer__about">
          {site.tagline}. Everything Minecraft. Engineered. AI, developer tools, open-source projects, and game development â€” engineered as one ecosystem.
        </p>
        <div class="footer__status">
          <span class="status-dot" aria-hidden="true"></span>
          <a href="/status" style="color:var(--text-muted);">All systems operational</a>
        </div>
        <p style="font-size:12.5px;color:var(--text-disabled);margin-top:10px;">
          Press <kbd>/</kbd> anywhere to search Â· <kbd>âŒ˜K</kbd> to open the command palette
        </p>
      </div>
      <div>
        <h4>Ecosystem</h4>
        <ul>
          {productLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h4>Platform</h4>
        <ul>
          {platformLinks.map((l) => (
            <li><a href={l.href} target={l.external ? "_blank" : undefined} rel={l.external ? "noopener" : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          {companyLinks.map((l) => (
            <li><a href={l.href} target={l.external ? "_blank" : undefined} rel={l.external ? "noopener" : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>Community</h4>
        <ul>
          <li>
            <a href={site.discordUrl} target="_blank" rel="noopener">Discord</a>
          </li>
          <li><a href="/support">Get help</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/brand">Brand assets</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span>Â© {new Date().getFullYear()} Hero Studios. An independent software and technology studio â€” not affiliated with any other company using a similar name. Licensed under <a href={site.licenseUrl} target="_blank" rel="noopener">HBBML</a>.</span>
      <span style="display:inline-flex;align-items:center;gap:16px;">
        <a href="/privacy">Privacy</a>
        <a href="/about#non-affiliation">Non-affiliation</a>
        <a href="/sitemap.xml">Sitemap</a>
        <a href="/feed.xml">RSS</a>
        <a href={`mailto:${site.email}`}>Email</a>
        <a href="#top">Back to top â†‘</a>
      </span>
    </div>
  </div>
</footer>
