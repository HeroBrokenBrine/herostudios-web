---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ProductCard from "../components/ProductCard.astro";
import { products, categories, sortedProducts, iconUrl, lifecycleMeta } from "../data/products.js";
import { roadmap, principles } from "../data/roadmap.js";
import { spotlight as partnerSpotlight } from "../data/spotlight.js";

const spotlight = products.find((p) => p.slug === "redstone-debugger");
const nowItems = roadmap.now;
const stableCount = products.filter((p) => ["stable", "released"].includes(p.lifecycle)).length;
const activeCount = products.filter((p) => p.lifecycle !== "roadmap").length;

// Randomised ecosystem grid — mixed every build (and every visit via JS).
const svgSet = new Set([]);
const pool = products.map((p) => ({
  slug: p.slug,
  name: p.name,
  tagline: p.tagline,
  version: p.version,
  loader: p.loader,
  lifecycle: p.lifecycle,
  label: lifecycleMeta[p.lifecycle].label,
  iconImg: p.iconImg,
  color: p.glyph.color,
  glow: p.glyph.glow,
  ext: svgSet.has(p.slug) ? "svg" : "png",
}));
function shuffle(arr) {
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}
const serverShuffled = shuffle([...products]);

// Randomised Featured spotlight — changes every build and every visit.
const featuredPool = products
  .filter((p) => p.capabilities && p.capabilities.length && p.lifecycle !== "roadmap")
  .map((p) => ({
    slug: p.slug,
    name: p.name,
    tagline: p.tagline,
    why: p.why,
    capabilities: p.capabilities,
    iconImg: p.iconImg,
    color: p.glyph.color,
    glow: p.glyph.glow,
  }));
const featuredPick = featuredPool[Math.floor(Math.random() * featuredPool.length)] || spotlight;
---

<Base active="/" title="The Minecraft Software Ecosystem">
  <section class="hero">
    <span class="hero-orb hero-orb--purple" aria-hidden="true"></span>
    <span class="hero-orb hero-orb--sea" aria-hidden="true"></span>
    <span class="hero-orb hero-orb--sky" aria-hidden="true"></span>
    <p class="eyebrow" style="justify-content:center;display:flex;">Hero Studios · Software &amp; Technology</p>
    <h1>
      Everything Minecraft. <span class="grad-text">Engineered.</span>
    </h1>
    <p class="lead">
      Performance-first software engineered to work together. Every product becomes part of one
      ecosystem — never a collection of mods.
    </p>
    <div class="hero__cta">
      <a class="btn btn--primary" href="/downloads">
        <Icon name="download" /> Download Hero Client
      </a>
      <a class="btn btn--ghost" href="/products">Explore the ecosystem</a>
    </div>
    <div class="hero__meta">
      <span class="chip">{products.length} products</span>
      <span class="chip">{stableCount} stable</span>
      <span class="chip">{activeCount} in active development</span>
      <span class="chip">One ecosystem</span>
    </div>
  </section>

  <!-- Categories -->
  <section class="section--tight container">
    <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr));">
      {categories.map((c) => {
        const count = products.filter((p) => p.category === c.id).length;
        return (
          <a class="card card--hover" href={`/products?category=${c.id}`} style="padding:22px;display:block;text-decoration:none;">
            <h3 style="font-size:16px;margin-bottom:6px;">{c.name}</h3>
            <p style="font-size:13.5px;color:var(--text-muted);">{c.blurb}</p>
            <p style="margin-top:10px;font-family:var(--font-mono);font-size:12px;color:var(--purple-text);">{count} product{count !== 1 ? "s" : ""}</p>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Products grid -->
  <section class="section container">
    <div class="reveal" style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:32px;">
      <div>
        <p class="eyebrow">The ecosystem</p>
        <h2 class="sec-title" style="margin-bottom:8px;">One ecosystem. Every tool.</h2>
        <p class="sec-lead">{products.length} products and growing — each with an honest lifecycle status. Stable means CI-built and tested. Roadmap means vision.</p>
      </div>
      <a class="link-arrow" href="/products">All products <Icon name="arrow" /></a>
    </div>
    <div class="grid grid--products reveal reveal-stagger" id="product-grid">
      {serverShuffled.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <script type="application/json" id="dashboard-data" set:html={JSON.stringify(pool)}></script>

  <script>
    // Re-shuffle the ecosystem grid on every visit so no category dominates.
    function shuffleCards() {
      const grid = document.getElementById("product-grid");
      const data = document.getElementById("dashboard-data");
      if (!grid || !data) return;
      let items = [];
      try { items = JSON.parse(data.textContent); } catch { return; }
      if (items.length < 2) return;
      for (let i = items.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [items[i], items[j]] = [items[j], items[i]];
      }
      grid.innerHTML = items
        .map((p) => {
          const glyph = p.iconImg
            ? `<img src="/product-icons/${p.slug}.${p.ext}?v=4" alt="" loading="lazy" decoding="async">`
            : "";
          const meta = p.version !== "—" ? `<span class="chip">v${p.version}</span>` : "";
          return `<a href="/products/${p.slug}" class="card card--hover product-card" style="--glyph:${p.color};--glyph-glow:${p.glow};--glow:${p.glow};">
            <div class="product-card__head">
              <div class="product-card__glyph" aria-hidden="true">${glyph}</div>
              <span class="badge badge--${p.lifecycle}"><span class="dot" aria-hidden="true"></span>${p.label}</span>
            </div>
            <h3 class="product-card__title">${p.name}</h3>
            <p class="product-card__tagline">${p.tagline}</p>
            <div class="product-card__meta">${meta}<span class="chip">${p.loader}</span></div>
          </a>`;
        })
        .join("");
    }
    shuffleCards();
    document.addEventListener("astro:page-load", shuffleCards);
  </script>

  <!-- How it works together -->
  <section class="section container">
    <div class="reveal" style="max-width:680px;margin-bottom:40px;">
      <p class="eyebrow">Why it works</p>
      <h2 class="sec-title">Built to work together</h2>
      <p class="sec-lead">One design language, one performance bar, one shared intelligence layer in the making. The site, the client, the docs, and the roadmap all speak the same language.</p>
    </div>
    <div class="grid grid--3 reveal">
      {principles.map((p) => (
        <div class="card card--hover">
          <div style="width:40px;height:40px;border-radius:10px;display:grid;place-items:center;background:rgba(139,92,246,.12);border:1px solid rgba(139,92,246,.25);color:var(--purple-text);margin-bottom:16px;">
            <Icon name="spark" />
          </div>
          <h3 style="font-size:16px;margin-bottom:8px;">{p.title}</h3>
          <p style="font-size:14px;color:var(--text-muted);">{p.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Community spotlight -->
  <section class="section container">
    <div class="card reveal" style="padding:clamp(28px,5vw,56px);background:linear-gradient(135deg,rgba(56,189,248,.08),rgba(17,24,39,.9) 45%);">
      <div class="grid grid--2" style="align-items:center;gap:40px;">
        <div>
          <p class="eyebrow">{partnerSpotlight.badge}</p>
          <h2 class="sec-title" style="margin-bottom:12px;">{partnerSpotlight.name}</h2>
          <p style="margin-bottom:14px;font-size:16.5px;">{partnerSpotlight.tagline}</p>
          <p style="color:var(--text-secondary);margin-bottom:20px;">{partnerSpotlight.description}</p>
          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:24px;">
            {partnerSpotlight.features.map((f) => <span class="chip">{f}</span>)}
          </div>
          <div class="hero__cta" style="justify-content:flex-start;">
            <a class="btn btn--primary" href={partnerSpotlight.url} target="_blank" rel="noopener"><Icon name="external" /> View on Modrinth</a>
            {partnerSpotlight.links.map((l) => (
              <a class="btn btn--ghost" href={l.url} target="_blank" rel="noopener">{l.label}</a>
            ))}
          </div>
        </div>
        <div class="glass" style="border-radius:var(--r-lg);padding:24px;display:grid;gap:14px;">
          <h3 style="font-size:16px;">Why you'll like it</h3>
          {partnerSpotlight.highlights.map((h) => (
            <div class="feature">
              <div class="feature__icon"><Icon name={h.icon} /></div>
              <div>
                <h4 style="font-size:14.5px;">{h.title}</h4>
                <p style="font-size:13.5px;color:var(--text-muted);">{h.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Spotlight -->
  <section class="section container">
    <div class="card reveal" id="featured-panel" style="padding:clamp(28px,5vw,56px);background:linear-gradient(135deg,rgba(139,92,246,.10),rgba(17,24,39,.9) 45%);">
      <div class="grid grid--2" style="align-items:center;">
        <div>
          <p class="eyebrow">Featured</p>
          <h2 class="sec-title" style="margin-bottom:12px;">{featuredPick.name}</h2>
          <p style="margin-bottom:20px;font-size:16.5px;">{featuredPick.tagline}</p>
          <p style="color:var(--text-secondary);margin-bottom:24px;">{featuredPick.why}</p>
          <div class="hero__cta" style="justify-content:flex-start;">
            <a class="btn btn--primary" href={`/products/${featuredPick.slug}`}>Learn more</a>
            <a class="btn btn--ghost" href={`/docs/${featuredPick.slug}`}>Documentation</a>
          </div>
        </div>
        <div class="glass" style="border-radius:var(--r-lg);padding:28px;display:grid;gap:14px;">
          {featuredPick.capabilities.map((c) => (
            <div class="feature">
              <div class="feature__icon">
                {iconUrl(featuredPick) ? <img src={iconUrl(featuredPick)} alt="" loading="lazy" /> : <Icon name={featuredPick.icon} />}
              </div>
              <div>
                <h3 style="font-size:15px;">{c.title}</h3>
                <p style="font-size:13.5px;color:var(--text-muted);">{c.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script type="application/json" id="featured-data" set:html={JSON.stringify(featuredPool)}></script>

  <script>
    // Randomise the Featured spotlight on every visit.
    function renderFeatured() {
      const panel = document.getElementById("featured-panel");
      const data = document.getElementById("featured-data");
      if (!panel || !data) return;
      let items = [];
      try { items = JSON.parse(data.textContent); } catch { return; }
      if (!items.length) return;
      const pick = items[Math.floor(Math.random() * items.length)];
      const img = pick.iconImg ? `<img src="/product-icons/${pick.slug}.png?v=4" alt="" loading="lazy">` : "";
      const caps = pick.capabilities
        .map((c) => `<div class="feature"><div class="feature__icon">${img}</div><div><h3 style="font-size:15px;">${c.title}</h3><p style="font-size:13.5px;color:var(--text-muted);">${c.desc}</p></div></div>`)
        .join("");
      panel.innerHTML = `
        <div class="grid grid--2" style="align-items:center;">
          <div>
            <p class="eyebrow">Featured</p>
            <h2 class="sec-title" style="margin-bottom:12px;">${pick.name}</h2>
            <p style="margin-bottom:20px;font-size:16.5px;">${pick.tagline}</p>
            <p style="color:var(--text-secondary);margin-bottom:24px;">${pick.why}</p>
            <div class="hero__cta" style="justify-content:flex-start;">
              <a class="btn btn--primary" href="/products/${pick.slug}">Learn more</a>
              <a class="btn btn--ghost" href="/docs/${pick.slug}">Documentation</a>
            </div>
          </div>
          <div class="glass" style="border-radius:var(--r-lg);padding:28px;display:grid;gap:14px;">${caps}</div>
        </div>`;
    }
    renderFeatured();
    document.addEventListener("astro:page-load", renderFeatured);
  </script>

  <!-- Downloads + Docs teaser -->
  <section class="section container">
    <div class="grid grid--2 reveal">
      <a class="card card--hover" href="/downloads" style="display:block;text-decoration:none;">
        <div style="width:44px;height:44px;border-radius:10px;display:grid;place-items:center;background:rgba(20,184,166,.12);border:1px solid rgba(20,184,166,.3);color:var(--sea-soft);margin-bottom:18px;"><Icon name="download" /></div>
        <h3 style="font-size:20px;margin-bottom:8px;">Downloads</h3>
        <p style="font-size:14.5px;color:var(--text-muted);margin-bottom:16px;">Every product, every version, one download centre. Latest builds first, with checksums.</p>
        <span class="link-arrow" style="color:var(--purple-text);">Open download centre <Icon name="arrow" /></span>
      </a>
      <a class="card card--hover" href="/docs" style="display:block;text-decoration:none;">
        <div style="width:44px;height:44px;border-radius:10px;display:grid;place-items:center;background:rgba(56,189,248,.12);border:1px solid rgba(56,189,248,.3);color:var(--sky);margin-bottom:18px;"><Icon name="book" /></div>
        <h3 style="font-size:20px;margin-bottom:8px;">Documentation</h3>
        <p style="font-size:14.5px;color:var(--text-muted);margin-bottom:16px;">One unified docs platform. Every product, one search, one navigation, one design language.</p>
        <span class="link-arrow" style="color:var(--purple-text);">Browse docs <Icon name="arrow" /></span>
      </a>
    </div>
  </section>

  <!-- Latest releases -->
  <section class="section container">
    <div class="reveal" style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:28px;">
      <div>
        <p class="eyebrow">Release notes</p>
        <h2 class="sec-title" style="margin-bottom:8px;">Recent releases</h2>
      </div>
      <a class="link-arrow" href="/releases">All releases <Icon name="arrow" /></a>
    </div>
    <div class="release-strip reveal reveal-stagger">
      {sortedProducts().filter((p) => p.version !== "—" && p.downloads.available).slice(0, 6).map((p) => (
        <a class="card card--hover" href={`/releases#${p.slug}`} style="display:flex;align-items:center;gap:12px;text-decoration:none;padding:18px 20px;">
          <span class="ic">{iconUrl(p) ? <img src={iconUrl(p)} alt="" loading="lazy" /> : <Icon name={p.icon} />}</span>
          <span style="min-width:0;">
            <span style="display:block;font-weight:600;color:var(--text-primary);font-size:15px;">{p.name}</span>
            <span class="mono" style="color:var(--text-muted);font-size:12px;">v{p.version}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Roadmap highlight -->
  <section class="section container">
    <div class="reveal" style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:32px;">
      <div>
        <p class="eyebrow">Roadmap</p>
        <h2 class="sec-title" style="margin-bottom:8px;">What we're building now</h2>
      </div>
      <a class="link-arrow" href="/roadmap">Full roadmap <Icon name="arrow" /></a>
    </div>
    <div class="timeline reveal">
      {nowItems.map((it) => (
        <div class="tl-item tl--now">
          <div class="tl-item__head">
            <h3>{it.title}</h3>
            <span class="chip">Now</span>
          </div>
          <p>{it.desc}{it.product ? ` — ${products.find((p) => p.slug === it.product)?.name}.` : ""}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="section container">
    <div class="cta-banner reveal">
      <h2>Built to work together.</h2>
      <p>Join the ecosystem. Download your first Hero Studios product, read the docs, and watch one ecosystem become many tools.</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="/downloads"><Icon name="download" /> Get started</a>
        <a class="btn btn--ghost" href="/about">About Hero Studios</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero__meta .chip { background: rgba(17,24,39,.7); }
</style>
