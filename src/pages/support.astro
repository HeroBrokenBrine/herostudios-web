---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site.js";

const faqGroups = [
  {
    title: "Getting started",
    items: [
      { q: "How do I install a Hero Studios mod?", a: "Most mods are Fabric mods. Install Fabric Loader for your Minecraft version, place the JAR (and Fabric API where noted) into your mods folder, then launch. Each product's docs has a quick start." },
      { q: "Is Hero Client free?", a: "Yes. Downloading and playing is free and account-free." },
      { q: "Where are the downloads?", a: "The download centre at /downloads lists every product with a version matrix and SHA-256 checksums. Products without releases are clearly marked." },
    ],
  },
  {
    title: "Compatibility",
    items: [
      { q: "Which Minecraft versions are supported?", a: "Each product page shows its exact compatibility matrix. 1.21–1.21.11 is the most broadly supported range; 26.x builds are experimental." },
      { q: "Does anything require a server mod?", a: "HeroSync is fully client-side and works on any server. Check each product's docs for specifics." },
      { q: "Why do some products show 'Roadmap' status?", a: "Transparency. Hero Renderer and Hero Launcher are in design — they have full vision pages but no shipped binaries, so they never show a download button." },
    ],
  },
  {
    title: "Support & reporting",
    items: [
      { q: "How do I get support for a specific product?", a: "Start with /docs/<product>. If that doesn't help, join the Discord or use the contact form." },
      { q: "How do I report a bug?", a: `Use the <a href="/support-portal.html">support portal</a> with your product, Minecraft version, and a crash log if you have one.` },
      { q: "What license applies?", a: `Hero Studios projects are distributed under the HBBML license (<a href="${site.licenseUrl}" target="_blank" rel="noopener">hbbml.tiiny.site</a>).` },
    ],
  },
];

const wizards = [
  { icon: "flag", title: "Bug report", desc: "Guided form → pre-filled report", href: "/support-portal.html", tone: "sea" },
  { icon: "spark", title: "Feature request", desc: "Request a feature via the portal", href: "/support-portal.html", tone: "purple" },
  { icon: "compass", title: "Troubleshooting", desc: "Start with the docs", href: "/docs", tone: "sky" },
];

const known = [
  { status: "stable", label: "Operational", name: "Website & downloads", note: "All pages and downloads available" },
  { status: "stable", label: "Operational", name: "Support portal", note: "/support-portal" },
  { status: "stable", label: "Operational", name: "Discord community", note: "discord.gg/5N4pAKRrkk" },
  { status: "beta", label: "In development", name: "Hero Client 1.9.5", note: "Active iteration across 1.21" },
];
---

<Base active="/support" title="Support" description="Help, FAQs, and troubleshooting for every Hero Studios product.">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqGroups.flatMap((g) => g.items).map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a.replace(/<[^>]+>/g, "") },
    })),
  })}></script>
  <section class="pagehead container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span class="sep">/</span> <span aria-current="page">Support</span>
    </nav>
    <p class="eyebrow">Support</p>
    <h1>How can we help?</h1>
    <p class="lead">Search the FAQs, run a guided report, or jump straight to the docs and community.</p>
  </section>

  <!-- Wizards -->
  <section class="container sec-sm">
    <div class="grid grid--3 reveal">
      {wizards.map((w) => (
        <a class="card card--hover" href={w.href} target={w.href.startsWith("http") ? "_blank" : undefined} rel={w.href.startsWith("http") ? "noopener" : undefined} style="text-decoration:none;display:block;">
          <div class="feature__icon" style="margin-bottom:14px;"><Icon name={w.icon} /></div>
          <h3 style="font-size:18px;margin-bottom:6px;">{w.title}</h3>
          <p style="font-size:14px;color:var(--text-muted);">{w.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- FAQ with search -->
  <section class="container sec-sm">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:24px;" class="reveal">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2 style="font-size:24px;">Frequently asked questions</h2>
      </div>
      <input class="input" id="faq-search" type="search" placeholder="Search the FAQ…" aria-label="Search FAQ" style="max-width:320px;" />
    </div>
    <div id="faq-root" style="display:grid;gap:28px;">
      {faqGroups.map((g) => (
        <div class="faq-group" data-label={g.title.toLowerCase()}>
          <h3 style="font-size:15px;margin-bottom:12px;color:var(--text-muted);font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.1em;">{g.title}</h3>
          <div class="accordion" style="max-width:820px;">
            {g.items.map((f) => (
              <details class="faq-item" data-text={`${f.q} ${f.a}`.toLowerCase()}>
                <summary>{f.q}</summary>
                <div class="acc-body"><div class="acc-inner" style="padding:0 20px 18px;">{f.a}</div></div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Status -->
  <section class="container sec-sm">
    <p class="eyebrow">Status</p>
    <h2 style="font-size:24px;margin-bottom:20px;">System status</h2>
    <div class="grid grid--2 reveal">
      {known.map((k) => (
        <div class="status-row">
          <div>
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:4px;">
              <span class={`status-dot`} style={k.status === "beta" ? "background:var(--sky);box-shadow:0 0 12px var(--sky);" : undefined}></span>
              <strong style="font-size:15px;color:var(--text-primary);">{k.name}</strong>
            </div>
            <p style="font-size:13.5px;color:var(--text-muted);">{k.note}</p>
          </div>
          <span class="chip">{k.label}</span>
        </div>
      ))}
    </div>
    <p style="font-size:13px;color:var(--text-muted);margin-top:14px;">Full status page: <a href="/status">/status</a></p>
  </section>

  <!-- Response expectations + community -->
  <section class="container sec-sm">
    <div class="grid grid--2">
      <div class="card reveal">
        <h3 style="font-size:17px;margin-bottom:10px;">Expected response times</h3>
        <ul style="margin:0 0 0 18px;color:var(--text-secondary);font-size:14px;line-height:2;">
          <li><strong>Critical / security:</strong> within 24h (Discord #security or email)</li>
          <li><strong>Bugs & crashes:</strong> within 1–3 days</li>
          <li><strong>Feature requests:</strong> reviewed on the roadmap, usually within a week</li>
          <li><strong>General questions:</strong> within a few days</li>
        </ul>
      </div>
      <div class="card reveal">
        <h3 style="font-size:17px;margin-bottom:10px;">Community & official channels</h3>
        <ul style="list-style:none;display:grid;gap:10px;font-size:14px;">
          <li><a href={site.discordUrl} target="_blank" rel="noopener">Discord — fastest support</a></li>
          <li><a href={site.issuesUrl}>Support portal</a></li>
          <li><a href="/support-portal.html">Support portal — guided bug report</a></li>
          <li><a href={`mailto:${site.email}`} target="_blank" rel="noopener">Email</a></li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<script>
  function filterFaq(term) {
    const t = term.toLowerCase().trim();
    document.querySelectorAll(".faq-item").forEach((el) => {
      const ok = !t || el.dataset.text.includes(t);
      el.hidden = !ok;
      if (!ok && el.open) el.open = false;
    });
    document.querySelectorAll(".faq-group").forEach((g) => {
      const any = Array.from(g.querySelectorAll(".faq-item")).some((el) => !el.hidden);
      g.hidden = !any;
    });
  }
  function initFaq() {
    const faqSearch = document.getElementById("faq-search");
    if (!faqSearch) return;
    faqSearch.oninput = () => filterFaq(faqSearch.value);
  }
  initFaq();
  document.addEventListener("astro:page-load", initFaq);
</script>
