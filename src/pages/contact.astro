---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site.js";

const channels = [
  { icon: "mail", title: "Email", desc: `For partnerships, press, and general inquiries — ${site.email}.`, action: "Send an email", href: `mailto:${site.email}` },
  { icon: "discord", title: "Discord", desc: `Community, support, and development chat — @${site.discordHandle}.`, action: "Join the server", href: site.discordUrl },
  { icon: "flag", title: "Bug reports", desc: "Found a bug? Report it via the support portal.", action: "Report a bug", href: site.issuesUrl },
  { icon: "users", title: "Collaboration", desc: "Building something with Hero Studios? Let's talk.", action: "Propose an integration", href: `mailto:${site.email}` },
];
---

<Base active="/contact" title="Contact" description="Get in touch with the Hero Studios team.">
  <section class="pagehead container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span class="sep">/</span> <span aria-current="page">Contact</span>
    </nav>
    <p class="eyebrow">Contact</p>
    <h1>Get in touch.</h1>
    <p class="lead">Questions, feedback, press, or collaboration — we read everything.</p>
  </section>

  <section class="container sec-sm">
    <div class="grid grid--2">
      {channels.map((c) => (
        <a class="card card--hover" href={c.href} target={c.href.startsWith("http") ? "_blank" : undefined} rel={c.href.startsWith("http") ? "noopener" : undefined} style="text-decoration:none;display:block;">
          <div class="feature__icon" style="margin-bottom:16px;"><Icon name={c.icon} /></div>
          <h3 style="font-size:18px;margin-bottom:6px;">{c.title}</h3>
          <p style="font-size:14px;color:var(--text-muted);margin-bottom:14px;">{c.desc}</p>
          <span class="link-arrow" style="color:var(--purple-text);">{c.action} <Icon name="arrow" /></span>
        </a>
      ))}
    </div>
  </section>

  <section class="container sec-tight">
    <div class="card" style="max-width:640px;">
      <h2 style="font-size:20px;margin-bottom:20px;">Send a message</h2>
      <form id="contact-form" action="#" method="post">
        <div class="field">
          <label for="name">Name</label>
          <input class="input" type="text" id="name" name="name" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input class="input" type="email" id="email" name="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="topic">Topic</label>
          <select class="input" id="topic" name="topic">
            <option>General inquiry</option>
            <option>Product support</option>
            <option>Bug report</option>
            <option>Partnership / press</option>
            <option>Collaboration</option>
          </select>
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea class="input" id="message" name="message" rows="6" required></textarea>
        </div>
        <button class="btn btn--primary" type="submit" style="width:100%;"><Icon name="mail" /> Send message</button>
      </form>
    </div>
  </section>

  <div class="toast" id="form-toast" role="status">Thanks — your message has been received.</div>

  <script>
    function bindContact() {
      const form = document.getElementById("contact-form");
      if (!form) return;
      const toast = document.getElementById("form-toast");
      let status = document.getElementById("contact-status");
      if (!status) {
        status = document.createElement("div");
        status.id = "contact-status";
        status.style.cssText = "margin-top:14px;font-size:14px;min-height:22px;text-align:center;";
        form.after(status);
      }
      form.onsubmit = (e) => {
        e.preventDefault();
        const name = document.getElementById("name").value.trim();
        const email = document.getElementById("email").value.trim();
        const message = document.getElementById("message").value.trim();
        if (!name) return (status.textContent = "Please enter your name.", status.style.color = "#f87171");
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return (status.textContent = "Please enter a valid email address.", status.style.color = "#f87171");
        if (message.length < 10) return (status.textContent = "Please write at least a short message.", status.style.color = "#f87171");
        status.textContent = "";
        toast.classList.add("show");
        setTimeout(() => toast.classList.remove("show"), 3000);
        form.reset();
      };
    }
    bindContact();
    document.addEventListener("astro:page-load", bindContact);
  </script>
</Base>
