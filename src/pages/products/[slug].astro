---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import LifecycleBadge from "../../components/LifecycleBadge.astro";
import ProductCard from "../../components/ProductCard.astro";
import { products, getRelated, lifecycleMeta, iconUrl, categories } from "../../data/products.js";
import { site } from "../../data/site.js";

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product } = Astro.props;
const related = getRelated(product);
const g = product.glyph;
const img = iconUrl(product);
const catName = categories.find((c) => c.id === product.category)?.name || product.category;
const statusTone = product.lifecycle === "roadmap" ? "info" : product.lifecycle === "alpha" || product.lifecycle === "in-development" ? "warn" : "info";
---

<Base
  title={product.name}
  description={product.tagline}
  active="/products"
  ogType="product"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: product.name,
    description: product.tagline,
    applicationCategory: "GameApplication",
    operatingSystem: product.loader,
    url: `https://herostudios.dev/products/${product.slug}`,
    softwareVersion: product.version === "—" ? undefined : product.version,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  })}></script>
  <section class="prod-hero container" style={`--glyph:${g.color};--glyph-glow:${g.glow};--hero-glow:${g.glow};`}>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span class="sep">/</span>
      <a href="/products">Products</a> <span class="sep">/</span>
      <span aria-current="page">{product.name}</span>
    </nav>
    <div class="prod-hero__glyph" aria-hidden="true">
      {img ? <img src={img} alt="" loading="eager" /> : <Icon name={product.icon} size={36} />}
    </div>
    <div class="prod-hero__badges">
      <LifecycleBadge lifecycle={product.lifecycle} />
      <span class="chip">{catName}</span>
      {product.version !== "—" && <span class="chip">v{product.version}</span>}
    </div>
    <h1>{product.name}</h1>
    <p class="lead">{product.tagline}</p>
    <div class="prod-hero__cta">
      {product.downloads.available ? (
        <a class="btn btn--primary" href={`/downloads/${product.slug}`}><Icon name="download" /> Download</a>
      ) : (
        <span class="btn btn--ghost" aria-disabled="true">Not yet available</span>
      )}
      <a class="btn btn--ghost" href={`/docs/${product.slug}`}><Icon name="book" /> Documentation</a>
      <a class="btn btn--ghost" href={`#roadmap`}><Icon name="flag" /> Roadmap</a>
      <button class="btn btn--ghost" id="share-link" type="button"><Icon name="copy" /> <span>Copy link</span></button>
    </div>
  </section>

  <section class="container sec-sm">
    <div class={`alert alert--${statusTone}`}>
      <Icon name={statusTone === "warn" ? "warn" : "info"} />
      <div>
        <strong>{lifecycleMeta[product.lifecycle].label} Â· </strong>
        {product.statusNote}
      </div>
    </div>
  </section>

  <section class="container sec-tight">
    <div class="grid grid--2" style="gap:40px;">
      <div>
        <p class="eyebrow">Why it exists</p>
        <h2 style="font-size:24px;margin-bottom:14px;">Purpose</h2>
        <p style="margin-bottom:24px;">{product.why}</p>
        <h3 style="font-size:17px;margin-bottom:10px;">Who it's for</h3>
        <p>{product.who}</p>
      </div>
      <div class="glass" style="border-radius:var(--r-lg);padding:24px;display:grid;gap:14px;">
        <h3 style="font-size:16px;">Key capabilities</h3>
        {product.capabilities.map((c) => (
          <div class="feature">
            <div class="feature__icon">
              {img ? <img src={img} alt="" loading="lazy" /> : <Icon name={product.icon} />}
            </div>
            <div>
              <h4 style="font-size:14.5px;">{c.title}</h4>
              <p style="font-size:13.5px;color:var(--text-muted);">{c.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container sec-tight">
    <div class="grid grid--2" style="gap:40px;align-items:start;">
      <div>
        <p class="eyebrow">Compatibility</p>
        <h2 style="font-size:22px;margin-bottom:16px;">Versions & loaders</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Property</th><th>Value</th></tr></thead>
            <tbody>
              <tr><td>Loader / platform</td><td>{product.loader}</td></tr>
              <tr><td>Latest version</td><td>{product.version === "—" ? "Not released" : product.version}</td></tr>
              <tr><td>Minecraft versions</td><td>{product.mcVersions.join(", ")}</td></tr>
            </tbody>
          </table>
        </div>
        <p style="font-size:13.5px;color:var(--text-muted);margin-top:12px;">{product.compatibility.note}</p>
      </div>

      <div>
        <p class="eyebrow">Version history</p>
        <h2 style="font-size:22px;margin-bottom:16px;">Changelog</h2>
        {product.changelog.length ? (
          <div class="timeline">
            {product.changelog.map((v) => (
              <div class="tl-item tl--done">
                <div class="tl-item__head"><h3 style="font-family:var(--font-mono);font-size:14px;">{v.version}</h3></div>
                <ul style="margin:0;padding-left:18px;color:var(--text-secondary);font-size:14px;">
                  {v.notes.map((n) => <li>{n}</li>)}
                </ul>
              </div>
            ))}
          </div>
        ) : (
          <p style="color:var(--text-muted);">No releases yet — this product is on the roadmap.</p>
        )}
      </div>
    </div>
  </section>

  <section class="container sec-tight" id="roadmap">
    <p class="eyebrow">Roadmap</p>
    <h2 style="font-size:22px;margin-bottom:24px;">Where it's going</h2>
    <div class="timeline">
      {product.roadmap.map((r) => (
        <div class={`tl-item ${r.status === "done" ? "tl--done" : r.status === "now" ? "tl--now" : r.status === "next" ? "tl--planned" : "tl--later"}`}>
          <div class="tl-item__head">
            <h3>{r.title}</h3>
            <span class="chip">{r.status}</span>
          </div>
          <p>{r.desc}</p>
        </div>
      ))}
    </div>
  </section>

  {product.docs.faq && product.docs.faq.length > 0 && (
    <section class="container sec-tight">
      <p class="eyebrow">FAQ</p>
      <h2 style="font-size:22px;margin-bottom:24px;">Questions, answered</h2>
      <div class="accordion" style="max-width:820px;">
        {product.docs.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div class="acc-body"><div class="acc-inner" style="padding:0 20px 18px;">{f.a}</div></div>
          </details>
        ))}
      </div>
    </section>
  )}

  <section class="container sec-tight">
    <p class="eyebrow">Compatibility & limitations</p>
    <h2 style="font-size:22px;margin-bottom:16px;">What to know</h2>
    <div class="grid grid--2" style="align-items:start;">
      <div class="alert alert--info"><Icon name="info" /><div><strong>Compatibility.</strong> {product.compatibility.note}</div></div>
      <div class="alert alert--info"><Icon name="warn" /><div><strong>Status.</strong> {product.statusNote}</div></div>
    </div>
  </section>

  <section class="container sec-tight">
    <p class="eyebrow">Downloads</p>
    <h2 style="font-size:22px;margin-bottom:16px;">Get {product.name}</h2>
    <div class="alert alert--info">
      <Icon name="download" />
      <div>{product.downloads.note}</div>
    </div>
    {product.downloads.available ? (
      <div class="hero__cta" style="justify-content:flex-start;margin-top:20px;">
        <a class="btn btn--primary" href={`/downloads/${product.slug}`}><Icon name="download" /> {product.downloads.sources.join(" · ")}</a>
      </div>
    ) : null}
  </section>

  {related.length > 0 && (
    <section class="container sec-tight" id="ecosystem">
      <p class="eyebrow">Ecosystem</p>
      <h2 style="font-size:24px;margin-bottom:10px;">Part of something bigger</h2>
      <p class="sec-lead" style="margin-bottom:28px;">
        Every Hero Studios product is engineered to work with the rest of the ecosystem — one design
        language, one performance bar, one long-term vision. {product.name} belongs alongside these tools.
      </p>
      <div class="grid grid--products">
        {related.map((r) => <ProductCard product={r} />)}
      </div>
      <div style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap;">
        <a class="btn btn--ghost" href="/products"><Icon name="layers" /> Explore all products</a>
        <a class="btn btn--ghost" href="/roadmap"><Icon name="flag" /> See the ecosystem roadmap</a>
      </div>
    </section>
  )}

  <section class="container sec-tight">
    <div class="cta-banner">
      <h2>{product.name} — ready when you are.</h2>
      <p>Install it, read the docs, and explore how it fits into the wider ecosystem.</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href={`/downloads/${product.slug}`}><Icon name="download" /> Get {product.name}</a>
        <a class="btn btn--ghost" href="/products">Explore all products</a>
        <a class="btn btn--ghost" href={site.donateUrl} target="_blank" rel="noopener"><Icon name="heart" /> Support the studio</a>
      </div>
    </div>
  </section>

  <script>
    function bindShare() {
      const btn = document.getElementById("share-link");
      if (!btn) return;
      btn.onclick = () => {
        const url = location.href;
        const label = btn.querySelector("span");
        const done = () => {
          if (label) { label.textContent = "Copied ✓"; setTimeout(() => (label.textContent = "Copy link"), 1600); }
        };
        if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(done).catch(() => window.prompt("Copy this link:", url));
        } else {
          const ta = document.createElement("textarea");
          ta.value = url;
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand("copy"); done(); } catch { window.prompt("Copy this link:", url); }
          ta.remove();
        }
      };
    }
    bindShare();
    document.addEventListener("astro:page-load", bindShare);
  </script>
</Base>
