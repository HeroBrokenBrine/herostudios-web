---
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import { productsByCategory, categories } from "../../data/products.js";

const groups = productsByCategory();
const activeCat = Astro.url.searchParams.get("category") || "";
---

<Base active="/products" title="Products" description="Every product in the Hero Studios ecosystem, with honest lifecycle status.">
  <section class="pagehead container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span class="sep">/</span> <span aria-current="page">Products</span>
    </nav>
    <p class="eyebrow">The ecosystem</p>
    <h1>One ecosystem. Every tool.</h1>
    <p class="lead">
      Performance mods to AI platforms to the Hero Client itself — every product shows its real lifecycle
      status. Stable means CI-built and tested. Roadmap means vision.
    </p>
  </section>

  <section class="container sec-sm">
    <div class="rm-toolbar reveal" role="toolbar" aria-label="Filter products by category" style="margin-bottom:0;">
      <span class="chip" style="color:var(--text-muted);font-family:var(--font-mono);">Filter:</span>
      <button type="button" class="tab cat-chip is-active" data-cat="">All</button>
      {categories.map((c) => (
        <button type="button" class="tab cat-chip" data-cat={c.id} aria-pressed="false">
          {c.name} <span class="cat-count" style="opacity:.7;font-family:var(--font-mono);font-size:11px;">{groups.find((g) => g.id === c.id)?.items.length ?? 0}</span>
        </button>
      ))}
    </div>
  </section>

  <div id="product-groups">
    {groups.map((g) => (
      <section class="container sec-sm cat-section" data-cat={g.id}>
        <div style="margin-bottom:20px;">
          <h2 style="font-size:20px;margin-bottom:4px;">{g.name}</h2>
          <p style="font-size:14px;color:var(--text-muted);">{g.blurb}</p>
        </div>
        <div class="grid grid--products reveal reveal-stagger">
          {g.items.map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    ))}
  </div>

  <section class="container sec-tight">
    <div class="cta-banner">
      <h2>Ready to download?</h2>
      <p>Pick a product and grab the build for your Minecraft version.</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="/downloads">Open download centre</a>
      </div>
    </div>
  </section>
</Base>

<script>
  function setCat(cat, updateUrl) {
    const chips = Array.from(document.querySelectorAll(".cat-chip"));
    const sections = Array.from(document.querySelectorAll(".cat-section"));
    const host = document.getElementById("product-groups");
    if (!host) return;
    chips.forEach((c) => {
      const active = c.dataset.cat === cat;
      c.classList.toggle("is-active", active);
      c.setAttribute("aria-pressed", String(active));
    });
    let any = false;
    sections.forEach((s) => {
      const show = !cat || s.dataset.cat === cat;
      s.hidden = !show;
      if (show) any = true;
    });
    const empty = host.querySelector(".cat-empty");
    if (!any && !empty) {
      const e = document.createElement("p");
      e.className = "cat-empty";
      e.textContent = "No products in this category yet.";
      e.style.cssText = "color:var(--text-muted);padding:24px 0;";
      host.prepend(e);
    } else if (any && empty) {
      empty.remove();
    }
    if (updateUrl) {
      const url = new URL(location.href);
      if (cat) url.searchParams.set("category", cat);
      else url.searchParams.delete("category");
      history.replaceState(null, "", url.pathname + url.search);
    }
  }

  // Re-binds after every navigation (View Transitions swaps the DOM).
  function initCats() {
    const chips = Array.from(document.querySelectorAll(".cat-chip"));
    if (!chips.length) return;
    chips.forEach((c) => {
      c.onclick = () => setCat(c.dataset.cat, true);
    });
    const initial = new URLSearchParams(location.search).get("category") || "";
    setCat(initial, false);
  }
  initCats();
  document.addEventListener("astro:page-load", initCats);
</script>
