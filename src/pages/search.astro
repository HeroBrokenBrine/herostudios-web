---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { products, categories, lifecycleMeta, iconUrl } from "../data/products.js";

const q = Astro.url.searchParams.get("q")?.trim().toLowerCase() || "";

const productHits = products.filter((p) =>
  [p.name, p.tagline, p.category, p.loader].join(" ").toLowerCase().includes(q)
);
const pageHits = [
  { title: "Products", url: "/products", desc: "Every product in the ecosystem" },
  { title: "Downloads", url: "/downloads", desc: "Download centre" },
  { title: "Documentation", url: "/docs", desc: "Unified docs platform" },
  { title: "Roadmap", url: "/roadmap", desc: "Ecosystem roadmap" },
  { title: "Developers", url: "/developers", desc: "Developer portal" },
  { title: "About", url: "/about", desc: "About Hero Studios" },
  { title: "Support", url: "/support", desc: "Help and FAQs" },
  { title: "Contact", url: "/contact", desc: "Get in touch" },
].filter((p) => p.title.toLowerCase().includes(q));
---

<Base active="" title={q ? `Search: ${q}` : "Search"} description="Search the Hero Studios ecosystem." noindex>
  <section class="pagehead container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span class="sep">/</span> <span aria-current="page">Search</span>
    </nav>
    <p class="eyebrow">Search</p>
    <h1>Search the ecosystem</h1>
    <form class="glass" style="display:flex;align-items:center;gap:12px;border-radius:var(--r-md);padding:8px 16px;max-width:560px;margin-top:20px;">
      <Icon name="search" />
      <input class="input" name="q" type="search" placeholder="Search products and pages…" style="border:none;background:transparent;box-shadow:none;" value={q} aria-label="Search query" />
      <button class="btn btn--sm btn--primary" type="submit" style="min-height:38px;">Go</button>
    </form>
  </section>

  <section class="container sec">
    {q ? (
      <>
        {productHits.length === 0 && pageHits.length === 0 && (
          <div class="alert alert--warn"><Icon name="warn" /><div>No results for “{q}”. Try a product name like HeroSync or Pack Merger.</div></div>
        )}
        {productHits.length > 0 && (
          <>
            <h2 style="font-size:18px;margin-bottom:16px;">Products</h2>
            <div class="grid grid--products" style="margin-bottom:40px;">
              {productHits.map((p) => (
                <a class="card card--hover" href={`/products/${p.slug}`} style={`--glyph:${p.glyph.color};--glyph-glow:${p.glyph.glow};text-decoration:none;display:block;`}>
                  <div class="product-card__head" style="margin-bottom:12px;">
                    <div class="product-card__glyph" style={`--glyph:${p.glyph.color};--glyph-glow:${p.glyph.glow};`}>
                      {iconUrl(p) ? <img src={iconUrl(p)} alt="" loading="lazy" /> : <Icon name={p.icon} />}
                    </div>
                    <span class={`badge badge--${p.lifecycle}`}><span class="dot"></span>{lifecycleMeta[p.lifecycle].label}</span>
                  </div>
                  <h3 style="font-size:17px;margin-bottom:6px;">{p.name}</h3>
                  <p style="font-size:14px;color:var(--text-muted);">{p.tagline}</p>
                </a>
              ))}
            </div>
          </>
        )}
        {pageHits.length > 0 && (
          <>
            <h2 style="font-size:18px;margin-bottom:16px;">Pages</h2>
            <div class="grid grid--2">
              {pageHits.map((p) => (
                <a class="card card--hover" href={p.url} style="text-decoration:none;display:block;">
                  <h3 style="font-size:16px;margin-bottom:6px;">{p.title}</h3>
                  <p style="font-size:14px;color:var(--text-muted);">{p.desc}</p>
                </a>
              ))}
            </div>
          </>
        )}
      </>
    ) : (
      <div class="grid grid--products">
        {categories.map((c) => {
          const items = products.filter((p) => p.category === c.id);
          return (
            <div class="card">
              <h3 style="font-size:16px;margin-bottom:12px;">{c.name}</h3>
              <ul style="list-style:none;display:flex;flex-direction:column;gap:8px;">
                {items.map((p) => <li><a href={`/products/${p.slug}`} style="font-size:14px;">{p.name}</a></li>)}
              </ul>
            </div>
          );
        })}
      </div>
    )}
  </section>
</Base>
